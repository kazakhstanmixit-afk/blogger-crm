+'use strict';
+const crypto=require('crypto'),fs=require('fs'),path=require('path'),multer=require('multer');
+function createFinanceClient({getState,persist,env=process.env,fetchImpl=fetch}){
+ let busy=false;const records=()=>getState().flowFinance||(getState().flowFinance=[]);
+ function request(raw,actor){const st=getState(),ids=[...new Set((raw.integrationIds||[]).map(String))];if(!ids.length)throw Error('Выберите интеграции');const deals=ids.map(id=>st.microInfluencerDeals.find(d=>String(d.id)===id));if(deals.some(d=>!d))throw Error('Интеграция не найдена');const bloggerId=deals[0].crmBloggerId;if(!bloggerId||deals.some(d=>d.crmBloggerId!==bloggerId))throw Error('Интеграции должны быть связаны с одним блогером CRM');
+  const stage=String(raw.stage||'').trim();if(!stage)throw Error('Укажите этап оплаты');const existing=records().find(p=>p.payload.stage===stage&&p.payload.integrationIds.some(id=>ids.includes(id)));if(existing){const requestedMinor=Math.round(Number(String(raw.amountKzt||'').replace(',','.'))*100);if(existing.payload.amountMinor!==requestedMinor||existing.payload.recipientName!==String(raw.recipientName||'')||existing.payload.settlement!==raw.settlement||existing.payload.integrationIds.length!==ids.length)throw Error('Заявка этого этапа уже существует с другими условиями');return existing;}
+  let employeeMap={};try{employeeMap=JSON.parse(env.FLOW_EMPLOYEE_CRM_MAP_JSON||'{}')}catch{}const managerId=employeeMap[deals[0].responsible];if(!managerId)throw Error('Сопоставьте ответственного с ID сотрудника CRM');
+  const amount=String(raw.amountKzt||'').replace(',','.');if(!/^\d+(\.\d{1,2})?$/.test(amount))throw Error('Проверьте сумму');const [a,b='']=amount.split('.'),minor=Number(a)*100+Number(b.padEnd(2,'0'));if(!Number.isSafeInteger(minor)||minor<=0)throw Error('Проверьте сумму');if(!['ip','cash'].includes(raw.settlement)||!String(raw.recipientName||'').trim())throw Error('Укажите способ расчёта и получателя');
+  const r={id:crypto.randomUUID(),status:'pending',requestedBy:actor,createdAt:new Date().toISOString(),nextAt:0,payload:{bloggerId,managerId,integrationIds:ids,stage,amountMinor:minor,settlement:raw.settlement,recipientName:String(raw.recipientName).slice(0,200),invoiceReference:String(raw.invoiceReference||'').slice(0,2000),notes:String(raw.notes||'').slice(0,3000)}};records().push(r);persist();return r;
+ }
+ async function drain(){if(busy||env.FINANCE_BRIDGE_ENABLED!=='1'||!env.CRM_ORIGIN||(env.FLOW_CRM_SECRET||'').length<32)return;busy=true;try{const origin=new URL(env.CRM_ORIGIN);if(origin.protocol!=='https:')return;
+  for(const row of records().filter(r=>r.nextAt<=Date.now()).slice(0,20)){try{const endpoint=row.crmPaymentId?'/api/integrations/payments/'+encodeURIComponent(row.crmPaymentId):'/api/integrations/payments';const response=await fetchImpl(new URL(endpoint,origin),{method:row.crmPaymentId?'GET':'POST',redirect:'error',signal:AbortSignal.timeout(12000),headers:{Authorization:'Bearer '+env.FLOW_CRM_SECRET,'Content-Type':'application/json','Idempotency-Key':'payment:'+row.id},body:row.crmPaymentId?undefined:JSON.stringify(row.payload)});if(!response.ok)throw Error('HTTP '+response.status);const data=await response.json();if(!data.crmPaymentId||data.amountMinor!==row.payload.amountMinor)throw Error('Не совпадает платёж CRM');row.crmPaymentId=data.crmPaymentId;row.status=data.status;row.receipts=data.receipts||[];row.bitrixStatus=data.bitrixStatus||null;row.bitrixItemId=data.bitrixItemId||null;
+   if(row.invoice&&!row.invoiceUploaded){const f=row.invoice,form=new FormData();form.append('managerId',row.payload.managerId);form.append('confirmed','true');form.append('invoice',new Blob([fs.readFileSync(f.path)]),f.name);const uploaded=await fetchImpl(new URL('/api/integrations/payments/'+encodeURIComponent(row.crmPaymentId)+'/invoice',origin),{method:'POST',redirect:'error',signal:AbortSignal.timeout(30000),headers:{Authorization:'Bearer '+env.FLOW_CRM_SECRET},body:form});if(!uploaded.ok)throw Error('HTTP '+uploaded.status);const ack=await uploaded.json();if(ack.crmPaymentId!==row.crmPaymentId||ack.invoiceSha256!==f.sha256)throw Error('Не совпадает счёт');row.invoiceUploaded=true;row.bitrixStatus=ack.bitrixStatus;row.bitrixItemId=ack.bitrixItemId;}
