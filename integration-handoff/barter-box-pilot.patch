+   const lastIn=getState().coord?.lastIn?.[to.phone];if(!channel.plain&&(!lastIn||Date.now()-Date.parse(lastIn)>23.5*3600000)){item.lastError='Для WABA нужно активное окно общения с тимлидом';persist();continue}
