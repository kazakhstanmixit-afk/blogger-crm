+const test=require('node:test'),assert=require('node:assert/strict');
+const {createService,syncOrderLinks,moneyMinor,mount}=require('../automation-flow');
+function fixture(){const state={orders:[],microInfluencerDeals:[{id:1,blogerName:'Блогер',instagramAccount:'https://instagram.com/test/',productStatus:'товар заказан'},{id:2,blogerName:'Блогер',instagramAccount:'https://instagram.com/test/',productStatus:''}]};let writes=0;const service=createService(()=>state,()=>writes++);let n=0;const cmd=(action,data,key)=>service.execute('Сая',{action,data},key||'request-'+(++n));cmd('catalog_import',{items:[{name:'Крем',barcode:'0000000000001',cost_kzt:'759.94',sku:'SKU1'}],dryRun:false});const productId=service.snapshot().catalog[0].id;const request=()=>cmd('shipment_request',{dealIds:[1,2],items:[{productId,qty:2}],city:'Астана',address:'Тест','phone':'+77000000000'});return {state,service,cmd,productId,request,writes:()=>writes};}
+test('exact money, no floating error',()=>{assert.equal(moneyMinor('759.94'),75994);assert.equal(moneyMinor('0'),0);assert.throws(()=>moneyMinor('-2'));assert.throws(()=>moneyMinor('1.999'));});
