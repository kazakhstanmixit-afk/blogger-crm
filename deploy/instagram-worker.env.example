# Private runtime file. Do not commit actual values. chmod 600.
CRM_ORIGIN=https://YOUR-EXISTING-CRM-HOST
BROWSER_ACCOUNT_ID=pilot-instagram
INSTAGRAM_EXPECTED_ACCOUNT_ID=REPLACE_WITH_NUMERIC_ACCOUNT_ID
INSTAGRAM_BROWSER_WORKER_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
INSTAGRAM_BROWSER_PROFILE_DIR=/var/lib/mixit/instagram-pilot
# Optional system Chromium; otherwise install Playwright Chromium.
# CHROMIUM_PATH=/usr/bin/chromium
